// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "restore_on_startup": "empty_tab",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "left",
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "use_modifier_to_send": true,
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "anthropic",
      "model": "claude-opus-4-6-1m-context-thinking-latest",
    },
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "focus_follows_mouse": {
    "enabled": true,
    "debounce_ms": 50
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "VSCode Dark Modern",
  },
  "languages": {
    "YAML": {
      "format_on_save": "off",
    },
  },
  "terminal": {
    "env": {
      "TERM": "xterm-256color",
      "COLORTERM": "truecolor"
    },
    "shell": {
      "with_arguments": {
        "program": "/run/current-system/sw/bin/zsh",
        "args": ["-l"]
      }
    }
  },
}
